# Local PostgreSQL connection, used by Prisma in apps/api.
DATABASE_URL="postgresql://lakshyaos:lakshyaos@localhost:5432/lakshyaos?schema=public"
# The web app only exposes variables deliberately prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
